{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mhomho",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-24",
  "upload_source_maps": true,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mhomho.work",
      "custom_domain": true
    },
    {
      "pattern": "setup.mhomho.work",
      "custom_domain": true
    },
    {
      "pattern": "app.mhomho.work",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/console/*",
      "/blog",
      "/blog/*",
      "/robots.txt",
      "/sitemap.xml",
      "/rss.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mhomho-db",
      "database_id": "373b682c-d1c4-4472-ac36-50d797c3561c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PROOFS",
      "id": "13d4edec73fa411c9c711075394bce41"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://mhomho.work",
    "SESSION_TTL_CREATOR_SECONDS": "28800",
    "SESSION_TTL_ADMIN_SECONDS": "1800",
    "MAX_UPLOAD_BYTES": "5242880",
    "PUBLIC_ACTIVITY": "true"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
