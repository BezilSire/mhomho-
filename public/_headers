# Security headers for static assets (Workers Static Assets honours this file).
#
# API responses are generated by the Worker and set their own headers in
# worker/src/index.ts; `_headers` does not apply to Worker-generated responses.
#
# The CSP allows Google Fonts because index.html loads Inter/Inter Tight from
# fonts.googleapis.com. No other third-party origin is permitted. `style-src`
# needs 'unsafe-inline' because components use React style attributes.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'

# Vite emits content-hashed bundles as /assets/index-<hash>.js|css, so those are
# immutable. Other files under /assets/ are not hashed and keep default caching.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/icon-maskable-512.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

/download/mhomho.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="mhomho.apk"
  Cache-Control: no-cache

/download/mhomho-creator-guide.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment; filename="mhomho-creator-guide.pdf"
  Cache-Control: no-cache
