rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /creators/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && request.resource.data.status == 'applied';
      allow update: if isOwner(uid) && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    match /creatorsPrivate/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /campaigns/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /campaignStats/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /campaignFinance/{id} {
      allow read, write: if isAdmin();
    }

    match /campaignMembers/{memberId} {
      // memberId is formatted as {campaignId}_{uid}
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /clips/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.creatorUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.verifiedViews == 0;
      allow update, delete: if false;
    }

    match /clips/{id}/snapshots/{snapshotId} {
      allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/clips/$(id)).data.creatorUid == request.auth.uid);
      allow write: if false;
    }

    match /ledger/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.creatorUid == request.auth.uid);
      allow write: if false;
    }

    match /payouts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.creatorUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /connectedAccounts/{accountId} {
      allow read, write: if false;
    }

    match /enquiries/{id} {
      allow read: if isAdmin();
      allow write: if false; // created via Cloud Function
    }

    match /brandViews/{token} {
      allow read: if true; // Private read-only token link
      allow write: if false;
    }

    match /config/money {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
